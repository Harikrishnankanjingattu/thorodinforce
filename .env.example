# THOR Platform — Environment Configuration Template
# Copy this file to .env.local to configure your local credentials.

# 0. NVIDIA NIM AI API Key (Optional: for real-time Llama-3.1 70B Thor thinking)
# Obtain a free key at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here

# 1. Candidate Alter-Ego Recipient Email
CANDIDATE_EMAIL=harikrishnankanjingattu2005@gmail.com
TO_EMAIL=harikrishnankanjingattu2005@gmail.com

# 2. Resend API Option (For 1-click live cloud email sending)
# Sign up at https://resend.com to obtain a free API key
RESEND_API_KEY=

# 3. Nodemailer / SMTP Option (Alternative to Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# 4. Firebase Authentication (Optional overrides)
# The application comes pre-configured with default Asgard project credentials (thor-b248f)
# You can override with your custom Firebase project if desired:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Note: If no email credentials are provided, the platform automatically runs
# in verified Raven Simulation mode, logging all details to console and presenting
# the full HTML email in the on-screen Evaluator Inspector!

